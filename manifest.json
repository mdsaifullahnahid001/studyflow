{
  "_comment": "StudyFlow PWA — Web App Manifest (manifest.json). Place in project root alongside index.html.",

  "name": "StudyFlow — Smart Study Planner",
  "short_name": "StudyFlow",
  "description": "A professional study routine manager with Pomodoro timer, progress tracking, OCR notes, gamification, and offline support.",

  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "/studyflow-pwa",

  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],

  "orientation": "any",

  "lang": "en-US",
  "dir": "ltr",

  "theme_color": "#1e1b4b",
  "background_color": "#0f0e1a",

  "categories": ["education", "productivity", "utilities"],
  "iarc_rating_id": "",

  "prefer_related_applications": false,

  "handle_links": "preferred",

  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 400
  },

  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-monochrome-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/dashboard-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "StudyFlow Dashboard — desktop view"
    },
    {
      "src": "/screenshots/dashboard-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "StudyFlow Dashboard — mobile view"
    },
    {
      "src": "/screenshots/pomodoro-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pomodoro Timer — mobile view"
    },
    {
      "src": "/screenshots/progress-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Progress Tracker — mobile view"
    }
  ],

  "shortcuts": [
    {
      "name": "Start Pomodoro",
      "short_name": "Pomodoro",
      "description": "Jump straight into a 25-minute focus session",
      "url": "/?tab=pomodoro&action=start&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-pomodoro.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Log Study Session",
      "short_name": "Log Session",
      "description": "Quickly log what you studied today",
      "url": "/?tab=log&action=new&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-log.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Progress",
      "short_name": "Progress",
      "description": "Check your streaks and achievement badges",
      "url": "/?tab=progress&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-progress.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Weekly Schedule",
      "short_name": "Schedule",
      "description": "View and rearrange your weekly study routine",
      "url": "/?tab=schedule&source=shortcut",
      "icons": [
        {
          "src": "/icons/shortcut-schedule.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],

  "related_applications": [],

  "protocol_handlers": [
    {
      "protocol": "web+studyflow",
      "url": "/?protocol=%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "application/json": [".json"],
        "text/csv":         [".csv"]
      }
    }
  ],

  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url",
      "files": [
        {
          "name":   "image",
          "accept": ["image/jpeg", "image/png", "image/webp", "image/gif"]
        }
      ]
    }
  }
}
